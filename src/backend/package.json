{
  "name": "barcode-control-room-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify service that generates and serves composite barcode label assets.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "generate": "tsx src/scripts/generateBarcodes.ts",
    "verify": "tsx src/scripts/verifyBarcodes.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bwip-js": "^4.5.1",
    "fastify": "^4.28.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
